FROM golang:1.22-alpine

RUN apk add --no-cache git ca-certificates curl

WORKDIR /app

# Install air for hot reload (v1.43.0 is compatible with Go 1.22)
RUN go install github.com/cosmtrek/air@v1.43.0

# Copy code
COPY . .

# Download dependencies
RUN go mod download

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
